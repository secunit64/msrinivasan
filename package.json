{
  "name": "madhu-srinivasan-profile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "observable preview --host localhost",
    "build": "node scripts/clean.mjs && observable build && node scripts/finalize.mjs",
    "check": "node scripts/check.mjs",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@observablehq/framework": "1.13.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "cheerio": "1.2.0",
    "prettier": "3.9.10"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
